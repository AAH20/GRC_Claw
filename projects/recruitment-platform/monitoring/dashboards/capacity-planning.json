{
  "dashboard": {
    "title": "Recruitment Platform - Capacity Planning",
    "uid": "recruitment-capacity",
    "timezone": "UTC",
    "refresh": "5m",
    "panels": [
      {
        "id": 1,
        "title": "CPU Utilization by Service",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{namespace=\"recruitment\"}[5m])",
            "legendFormat": "{{pod}}"
          }
        ],
        "alert": {
          "conditions": [
            {
              "evaluator": { "params": [0.8], "type": "gt" },
              "operator": { "type": "and" },
              "query": { "params": ["A", "5m", "now"] },
              "reducer": { "type": "avg" }
            }
          ],
          "name": "CPU > 80%",
          "message": "Service {{ $labels.pod }} CPU above 80%"
        }
      },
      {
        "id": 2,
        "title": "Memory Usage vs Limit",
        "type": "gauge",
        "targets": [
          {
            "expr": "container_memory_usage_bytes{namespace=\"recruitment\"} / container_spec_memory_limit_bytes{namespace=\"recruitment\"}",
            "legendFormat": "{{pod}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 0.7 },
                { "color": "red", "value": 0.85 }
              ]
            },
            "unit": "percentunit"
          }
        }
      },
      {
        "id": 3,
        "title": "Request Rate & Latency",
        "type": "timeseries",
        "targets": [
          {
            "expr": "rate(http_requests_total{namespace=\"recruitment\"}[5m])",
            "legendFormat": "RPS - {{service}}",
            "yaxis": "left"
          },
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{namespace=\"recruitment\"}[5m]))",
            "legendFormat": "P95 - {{service}}",
            "yaxis": "right"
          }
        ]
      },
      {
        "id": 4,
        "title": "Database Connection Pool",
        "type": "stat",
        "targets": [
          {
            "expr": "db_connections_active{namespace=\"recruitment\"}",
            "legendFormat": "Active"
          },
          {
            "expr": "db_connections_idle{namespace=\"recruitment\"}",
            "legendFormat": "Idle"
          }
        ]
      },
      {
        "id": 5,
        "title": "Storage Growth Trend",
        "type": "timeseries",
        "targets": [
          {
            "expr": "predict_linear(kube_persistentvolumeclaim_status_phase{namespace=\"recruitment\",phase=\"Pending\"}[6h], 7*24*3600)",
            "legendFormat": "7-day forecast - {{persistentvolumeclaim}}"
          }
        ]
      },
      {
        "id": 6,
        "title": "Pod Count vs HPA Target",
        "type": "timeseries",
        "targets": [
          {
            "expr": "kube_deployment_status_replicas{namespace=\"recruitment\"}",
            "legendFormat": "Current - {{deployment}}"
          },
          {
            "expr": "kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"recruitment\"}",
            "legendFormat": "Max - {{horizontalpodautoscaler}}"
          }
        ]
      }
    ],
    "templating": {
      "list": [
        {
          "name": "service",
          "type": "query",
          "query": "label_values(http_requests_total{namespace=\"recruitment\"}, service)",
          "multi": true,
          "includeAll": true
        }
      ]
    }
  }
}
