# -----------------------------------------------------------------------------
# Recruitment Platform - Terraform Variables Example
# -----------------------------------------------------------------------------
# Copy this file to terraform.tfvars and customize values for your environment.
# NEVER commit terraform.tfvars to version control.
# -----------------------------------------------------------------------------

# General
project_name = "recruitment-platform"
environment  = "development"
aws_region   = "us-east-1"
owner        = "platform-team"
cost_center  = "engineering"

# VPC
vpc_cidr = "10.0.0.0/16"
az_count = 3

# EKS
kubernetes_version = "1.28"
eks_public_access  = false

# EKS General Node Group
eks_node_instance_types = ["m6i.large"]
eks_node_min_size       = 2
eks_node_max_size       = 5
eks_node_desired_size   = 3

# EKS Spot Node Group
eks_spot_instance_types = ["m6i.large", "m5.large", "m5a.large"]
eks_spot_min_size       = 0
eks_spot_max_size       = 10
eks_spot_desired_size   = 2

# RDS
rds_engine_version       = "15.4"
rds_instance_class       = "db.t3.medium"
rds_allocated_storage    = 100
rds_max_allocated_storage = 500
rds_database_name        = "recruitment_platform"
rds_username             = "recruitment_admin"
rds_backup_retention     = 30

# ElastiCache
elasticache_engine_version    = "7.0"
elasticache_node_type         = "cache.t3.medium"
elasticache_num_cache_clusters = 2

# S3
backup_retention_days = 90
