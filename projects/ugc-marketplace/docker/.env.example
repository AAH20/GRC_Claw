# ============================================================
# UGC Marketplace — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=ugc_marketplace
POSTGRES_USER=ugc_user
POSTGRES_PASSWORD=change-me-strong-password

# --- Redis ---
REDIS_PASSWORD=change-me-strong-redis-password

# --- Backend (FastAPI) ---
SECRET_KEY=change-me-32-char-minimum-secret-key
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
BACKEND_WORKERS=4

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://backend:8000

# --- Nginx / TLS ---
# Path to SSL certificate and key (relative to docker/ directory)
SSL_CERT_PATH=./certs/fullchain.pem
SSL_KEY_PATH=./certs/privkey.pem

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60
