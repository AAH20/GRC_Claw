# =============================================================================
# UGC Marketplace — Example Terraform Variables
# =============================================================================
# Copy this file to terraform.tfvars and customize values for your environment.
# NEVER commit terraform.tfvars to version control (contains secrets).
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------

project_name = "ugc-marketplace"
environment  = "prod"
aws_region   = "us-east-1"
owner        = "platform-team"
cost_center  = "engineering"

# -----------------------------------------------------------------------------
# VPC / Networking
# -----------------------------------------------------------------------------

vpc_cidr                = "10.0.0.0/16"
availability_zone_count = 3
enable_nat_gateway      = true
single_nat_gateway      = false
enable_vpc_flow_logs    = true
flow_logs_retention_days = 30

# -----------------------------------------------------------------------------
# EKS (Kubernetes)
# -----------------------------------------------------------------------------

eks_cluster_version                    = "1.29"
eks_cluster_endpoint_private_access    = true
eks_cluster_endpoint_public_access     = false
eks_cluster_endpoint_public_access_cidrs = []
eks_cluster_enabled_log_types           = ["api", "audit", "authenticator", "controllerManager", "scheduler"]

# Node groups configuration
eks_node_groups = {
  general = {
    name           = "general"
    instance_types = ["m6i.large"]
    capacity_type  = "ON_DEMAND"
    disk_size      = 50
    min_size       = 2
    max_size       = 6
    desired_size   = 3
    labels = {
      workload = "general"
    }
    taints = []
  }
  compute = {
    name           = "compute"
    instance_types = ["c6i.xlarge"]
    capacity_type  = "ON_DEMAND"
    disk_size      = 50
    min_size       = 1
    max_size       = 4
    desired_size   = 2
    labels = {
      workload = "compute"
    }
    taints = []
  }
  spot = {
    name           = "spot"
    instance_types = ["m6i.large", "m5.large", "m5a.large"]
    capacity_type  = "SPOT"
    disk_size      = 50
    min_size       = 0
    max_size       = 10
    desired_size   = 0
    labels = {
      workload = "spot"
    }
    taints = []
  }
}

# -----------------------------------------------------------------------------
# RDS (PostgreSQL)
# -----------------------------------------------------------------------------

rds_engine         = "postgres"
rds_engine_version = "16.2"
rds_instance_class = "db.r6g.large"
rds_port           = 5432

rds_database_name   = "ugc_marketplace"
rds_master_username = "ugc_admin"
# IMPORTANT: Use a secrets manager or environment variable for the password
# export TF_VAR_rds_master_password="your-secure-password"
rds_master_password = ""

rds_allocated_storage     = 100
rds_max_allocated_storage = 500
rds_storage_type          = "gp3"
rds_storage_encrypted     = true

rds_multi_az                = true
rds_backup_retention_period = 30
rds_backup_window           = "03:00-04:00"
rds_maintenance_window      = "sun:04:00-sun:05:00"
rds_deletion_protection     = true
rds_skip_final_snapshot     = false
rds_final_snapshot_identifier = null

rds_performance_insights_enabled = true

# -----------------------------------------------------------------------------
# ElastiCache (Redis)
# -----------------------------------------------------------------------------

elasticache_engine         = "redis"
elasticache_engine_version = "7.1"
elasticache_node_type      = "cache.r6g.large"
elasticache_port           = 6379

elasticache_num_cache_nodes            = 2
elasticache_automatic_failover_enabled = true
elasticache_multi_az_enabled           = true

elasticache_at_rest_encryption_enabled = true
elasticache_transit_encryption_enabled = true

elasticache_snapshot_retention_limit = 7
elasticache_snapshot_window          = "05:00-06:00"
elasticache_maintenance_window       = "sun:06:00-sun:07:00"

# -----------------------------------------------------------------------------
# S3 (Storage)
# -----------------------------------------------------------------------------

s3_create_app_bucket     = true
s3_app_bucket_versioning = true
s3_app_bucket_lifecycle_rules = []
s3_app_bucket_cors_rules   = []

s3_create_media_bucket     = true
s3_media_bucket_versioning = true
s3_media_bucket_cors_rules = [{
  allowed_headers = ["*"]
  allowed_methods = ["GET", "HEAD"]
  allowed_origins = ["*"]
  expose_headers  = ["ETag"]
  max_age_seconds = 3000
}]

s3_create_logs_bucket = true
s3_logs_bucket_lifecycle_rules = [{
  id      = "archive-old-logs"
  enabled = true
  prefix  = ""
  transitions = [
    {
      days          = 30
      storage_class = "STANDARD_IA"
    },
    {
      days          = 90
      storage_class = "GLACIER"
    }
  ]
  expiration = {
    days = 365
  }
}]

s3_block_public_acls       = true
s3_block_public_policy     = true
s3_ignore_public_acls      = true
s3_restrict_public_buckets = true

# -----------------------------------------------------------------------------
# CloudFront (CDN)
# -----------------------------------------------------------------------------

cloudfront_create_alb_origin    = true
cloudfront_default_cache_ttl    = 86400
cloudfront_default_cache_max_ttl = 31536000
cloudfront_default_cache_compress = true
cloudfront_ordered_cache_behaviors = []

# ACM certificate ARN (must be in us-east-1 for CloudFront)
cloudfront_acm_certificate_arn = ""
cloudfront_aliases             = ["cdn.ugc-marketplace.example.com"]

cloudfront_enable_logging = true
cloudfront_create_waf     = true
cloudfront_waf_web_acl_arn = ""

# -----------------------------------------------------------------------------
# Route 53 (DNS)
# -----------------------------------------------------------------------------

create_route53_records = true
create_route53_zone    = false
domain_name            = "ugc-marketplace.example.com"

# -----------------------------------------------------------------------------
# Monitoring (CloudWatch)
# -----------------------------------------------------------------------------

monitoring_enable_rds_alarms       = true
monitoring_enable_elasticache_alarms = true
monitoring_enable_eks_alarms       = true
monitoring_alarm_notification_arns  = []
