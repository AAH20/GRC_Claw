# Application
APP_NAME=job-description-optimizer
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# LLM Configuration
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# LangChain / LangGraph
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_your-key-here
LANGCHAIN_PROJECT=job-description-optimizer

# Agent Configuration
MAX_AGENT_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=120
ENABLE_FALLBACK=true

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
