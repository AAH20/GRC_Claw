# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# LLM / LangChain
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# External APIs
ATS_API_URL=https://api.ats.example.com
ATS_API_KEY=your-ats-key
HRMS_API_URL=https://api.hrms.example.com
HRMS_API_KEY=your-hrms-key

# Cache / Queue
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruitment_analytics

# Observability
ENABLE_METRICS=true
ENABLE_TRACING=false
JAEGER_ENDPOINT=http://localhost:14268/api/traces
