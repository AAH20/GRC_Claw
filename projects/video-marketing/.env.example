# Video Marketing Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ─── Application ───────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG
SECRET_KEY=change-me-in-production
DEBUG=true

# ─── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ─── LLM / OpenAI ─────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096

# ─── LangChain / LangGraph ────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=video-marketing

# ─── YouTube API ──────────────────────────────────────────────
YOUTUBE_API_KEY=your-youtube-api-key-here
YOUTUBE_CLIENT_ID=your-youtube-client-id-here
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret-here
YOUTUBE_REFRESH_TOKEN=your-youtube-refresh-token-here

# ─── Instagram API ────────────────────────────────────────────
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token-here
INSTAGRAM_APP_ID=your-instagram-app-id-here
INSTAGRAM_APP_SECRET=your-instagram-app-secret-here

# ─── TikTok API ───────────────────────────────────────────────
TIKTOK_ACCESS_TOKEN=your-tiktok-access-token-here
TIKTOK_APP_ID=your-tiktok-app-id-here
TIKTOK_APP_SECRET=your-tiktok-app-secret-here

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/video_marketing
REDIS_URL=redis://localhost:6379/0

# ─── Monitoring ───────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
PROMETHEUS_ENABLED=true
METRICS_PORT=9090

# ─── Security ─────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
