# SEO Optimizer Environment Configuration
# Copy this file to .env and fill in your values

# ─── Application ───────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false
SECRET_KEY=change-me-in-production

# ─── API ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ─── LLM ──────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=4096

# ─── Google Search Console ────────────────────────────────────
GOOGLE_SEARCH_CONSOLE_ENABLED=false
GOOGLE_SEARCH_CONSOLE_CREDENTIALS_PATH=/path/to/google-search-console-credentials.json
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://yourdomain.com

# ─── SEMrush ──────────────────────────────────────────────────
SEMRUSH_ENABLED=false
SEMRUSH_API_KEY=your-semrush-api-key-here

# ─── Ahrefs ───────────────────────────────────────────────────
AHREFS_ENABLED=false
AHREFS_API_KEY=your-ahrefs-api-key-here

# ─── Screaming Frog ───────────────────────────────────────────
SCREAMING_FROG_ENABLED=false
SCREAMING_FROG_SPIDER_PATH=/path/to/ScreamingFrogSEOSpider

# ─── Cache ────────────────────────────────────────────────────
CACHE_BACKEND=memory
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMITING_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_SIZE=10

# ─── Monitoring ───────────────────────────────────────────────
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
SENTRY_DSN=

# ─── Agents ───────────────────────────────────────────────────
MAX_CONCURRENT_AGENTS=3
AGENT_TIMEOUT_SECONDS=300
AGENT_RETRY_ATTEMPTS=3
AGENT_RETRY_DELAY_SECONDS=5
