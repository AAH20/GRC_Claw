# Governance Agent - Environment Variables
# Copy this file to .env and fill in your values

# Application
APP_NAME=Governance Agent
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
APP_SECRET_KEY=change-me-to-a-secure-random-string
APP_LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# LangChain / LLM
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
LANGCHAIN_API_KEY=lsv2-your-langchain-api-key-here
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=governance-agent

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/governance_agent
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# Compliance
COMPLIANCE_PRE_APPROVAL_REQUIRED=true
COMPLIANCE_AUDIT_RETENTION_DAYS=2555
COMPLIANCE_LOG_ALL_CONTENT=true
COMPLIANCE_POLICY_ENGINE_URL=http://localhost:9000

# Security
API_KEY=your-api-key-for-production
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ENCRYPTION_KEY=your-32-byte-encryption-key-here
ENCRYPTION_ALGORITHM=AES-256-GCM

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
SENTRY_DSN=your-sentry-dsn
JAEGER_ENDPOINT=http://jaeger:14268/api/traces

# CORS
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# Agent Configuration
AGENT_DISCOVERY_SCAN_INTERVAL=300
AGENT_DISCOVERY_PROJECT_ROOTS=/projects
AGENT_DEPENDENCY_MAX_DEPTH=10
AGENT_DEPENDENCY_CACHE_TTL=3600
AGENT_RESOURCE_REBALANCE_INTERVAL=600
AGENT_HEALTH_CHECK_INTERVAL=60
AGENT_COST_ANALYSIS_INTERVAL=3600

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=governance-agent
STRUCTLOG_PRETTY=false
