# Application
APP_NAME=creator-monetization
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/creator_monetization
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# LangChain / LLM
OPENAI_API_KEY=your-openai-api-key-here
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=creator-monetization

# Agent Models
REVENUE_OPTIMIZER_MODEL=gpt-4
PAYOUT_MANAGER_MODEL=gpt-4
TIER_RECOMMENDER_MODEL=gpt-4
SUBSCRIPTION_MODEL=gpt-4
ANALYTICS_MODEL=gpt-4

# Integrations
STRIPE_API_KEY=your-stripe-api-key-here
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret-here
PAYPAL_CLIENT_ID=your-paypal-client-id-here
PAYPAL_CLIENT_SECRET=your-paypal-client-secret-here
PATREON_API_KEY=your-patreon-api-key-here

# Monitoring
PROMETHEUS_ENABLED=true
SENTRY_ENABLED=false
SENTRY_DSN=

# Security
ACCESS_TOKEN_EXPIRE_MINUTES=30