# Skills Assessor Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=skills-assessor
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# LangChain / LLM
OPENAI_API_KEY=your-openai-api-key-here
LANGCHAIN_API_KEY=your-langchain-api-key-here
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=skills-assessor
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# DeepAgents
DEEPAGENTS_MAX_ITERATIONS=10
DEEPAGENTS_TIMEOUT_SECONDS=300

# Storage
DATABASE_URL=sqlite+aiosqlite:///./skills_assessor.db
REDIS_URL=redis://localhost:6379/0

# Assessment Defaults
DEFAULT_PROFICIENCY_THRESHOLD=0.7
MAX_SKILLS_PER_ASSESSMENT=50
MIN_CONFIDENCE_SCORE=0.5
