# Application
APP_NAME=employer-branding
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# AI/LLM
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# External Services
REDIS_URL=redis://localhost:6379/0
GLASSDOOR_API_KEY=
LINKEDIN_API_KEY=
INDEED_API_KEY=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Content Generation
MAX_CONTENT_LENGTH=10000
DEFAULT_LANGUAGE=en
