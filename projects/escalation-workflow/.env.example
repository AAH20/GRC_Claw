# Environment variables template
ESCALATION_ENVIRONMENT=development
ESCALATION_DEBUG=true
ESCALATION_HOST=0.0.0.0
ESCALATION_PORT=8000

# LLM Configuration
ESCALATION_OPENAI_API_KEY=your-openai-api-key
ESCALATION_LLM_MODEL=gpt-4o-mini
ESCALATION_LLM_TEMPERATURE=0.1

# Redis
ESCALATION_REDIS_URL=redis://localhost:6379/0

# Database
ESCALATION_DATABASE_URL=sqlite:///./escalation_workflow.db

# SLA Defaults
ESCALATION_DEFAULT_SLA_MINUTES=60
ESCALATION_CRITICAL_SLA_MINUTES=15
ESCALATION_HIGH_SLA_MINUTES=30
ESCALATION_MEDIUM_SLA_MINUTES=120
ESCALATION_LOW_SLA_MINUTES=480

# Notifications
ESCALATION_SLACK_WEBHOOK_URL=
ESCALATION_PAGERDUTY_API_KEY=

# Observability
ESCALATION_LOG_LEVEL=INFO
ESCALATION_ENABLE_METRICS=true
