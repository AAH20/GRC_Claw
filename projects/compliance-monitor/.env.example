# Application
APP_NAME=compliance-monitor
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# LangChain / DeepAgents
LANGCHAIN_API_KEY=your-langchain-api-key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=compliance-monitor
OPENAI_API_KEY=your-openai-api-key

# Integrations
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=

# Storage
DATABASE_URL=sqlite+aiosqlite:///./compliance.db
REDIS_URL=redis://localhost:6379/0
