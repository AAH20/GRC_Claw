# GRC_Claw — Environment Variables Template
# Copy to .env.local and customize for your local development environment.
# NEVER commit .env.local to version control.

# ── Gateway ────────────────────────────────────────────────────────────────

GRC_CLAW_GATEWAY_TOKEN=dev-gateway-token
GRC_CLAW_HOST=0.0.0.0
GRC_CLAW_PORT=18791

# ── A2Z SOC Integration ────────────────────────────────────────────────────

A2Z_SOC_MODE=demo
A2Z_SOC_BASE_URL=http://host.docker.internal:3000
A2Z_SOC_API_KEY=
A2Z_SOC_TENANT_ID=1

# ── Database (PostgreSQL) ──────────────────────────────────────────────────

DATABASE_URL=postgresql+asyncpg://grc_claw:grc_claw_dev_password@postgres:5432/grc_claw
POSTGRES_USER=grc_claw
POSTGRES_PASSWORD=grc_claw_dev_password
POSTGRES_DB=grc_claw

# ── Redis ──────────────────────────────────────────────────────────────────

REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# ── Kafka ──────────────────────────────────────────────────────────────────

KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_PREFIX=grc-claw-dev

# ── MinIO (Object Storage) ─────────────────────────────────────────────────

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=grc-claw-evidence
MINIO_CONSOLE_PORT=9001

# ── Vault ──────────────────────────────────────────────────────────────────

VAULT_ADDR=http://vault:8200
VAULT_TOKEN=dev-root-token
VAULT_MOUNT_PATH=secret

# ── OpenTelemetry ──────────────────────────────────────────────────────────

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=grc-claw
OTEL_RESOURCE_ATTRIBUTES=environment=development,team=grc

# ── Observability ──────────────────────────────────────────────────────────

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
JAEGER_PORT=16686
LOKI_PORT=3100

# ── Service URLs (Internal) ────────────────────────────────────────────────

POLICY_API_URL=http://policy-api:8080
PDP_SERVICE_URL=http://pdp-service:8080
PEP_GATEWAY_URL=http://pep-gateway:8080
AGENT_IDENTITY_URL=http://agent-identity:8080
ANALYTICS_ENGINE_URL=http://analytics-engine:8080
REPORTING_ENGINE_URL=http://reporting-engine:8080
EVIDENCE_COLLECTOR_URL=http://evidence-collector:8080
EVIDENCE_VALIDATOR_URL=http://evidence-validator:8080
COMPLIANCE_MAPPING_URL=http://compliance-mapping:8080

# ── Logging ────────────────────────────────────────────────────────────────

LOG_LEVEL=debug
LOG_FORMAT=json
LOG_OUTPUT=stdout

# ── Security ───────────────────────────────────────────────────────────────

# JWT signing secret (dev only — use Vault in production)
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRATION_HOURS=24

# Encryption key for sensitive data at rest (dev only)
ENCRYPTION_KEY=dev-encryption-key-32bytes!!

# ── Feature Flags ──────────────────────────────────────────────────────────

ENABLE_METRICS=true
ENABLE_TRACING=true
ENABLE_PROFILING=false
ENABLE_AUDIT_LOG=true

# ── Rate Limiting ──────────────────────────────────────────────────────────

RATE_LIMIT_REQUESTS_PER_MINUTE=1000
RATE_LIMIT_BURST=100

# ── CORS ───────────────────────────────────────────────────────────────────

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:18791
CORS_ALLOW_CREDENTIALS=true

# ── Email (for notifications) ───────────────────────────────────────────────

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@grc-claw.local

# ── External Integrations ──────────────────────────────────────────────────

# Anthropic API (for AI features)
ANTHROPIC_API_KEY=

# OpenAI API (for AI features)
OPENAI_API_KEY=

# ── Development Tools ──────────────────────────────────────────────────────

# Tilt settings
TILT_HOST=127.0.0.1
TILT_PORT=10350

# Skaffold settings
SKAFFOLD_DEFAULT_REPO=
SKAFFOLD_PUSH=false

# ── Kind Cluster ───────────────────────────────────────────────────────────

KIND_CLUSTER_NAME=grc-claw
KIND_NODE_IMAGE=kindest/node:v1.28.0

# ── Docker Compose ─────────────────────────────────────────────────────────

COMPOSE_PROJECT_NAME=grc-claw
COMPOSE_FILE=docker-compose.yml

# ── Kubernetes ─────────────────────────────────────────────────────────────

KUBECONFIG=~/.kube/config
K8S_NAMESPACE_CONTROL_PLANE=grc-claw-control-plane
K8S_NAMESPACE_DATA=grc-claw-data
K8S_NAMESPACE_ANALYTICS=grc-claw-analytics
K8S_NAMESPACE_EVIDENCE=grc-claw-evidence
K8S_NAMESPACE_OBSERVABILITY=grc-claw-observability

# ── Migration ──────────────────────────────────────────────────────────────

ALEMBIC_CONFIG=alembic.ini
MIGRATION_BATCH_SIZE=1000

# ── Testing ────────────────────────────────────────────────────────────────

TEST_DATABASE_URL=postgresql+asyncpg://grc_claw:grc_claw_dev_password@postgres:5432/grc_claw_test
PYTEST_WORKERS=4
COVERAGE_THRESHOLD=80
