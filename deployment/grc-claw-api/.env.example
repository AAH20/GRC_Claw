# GRC_Claw API Configuration

# Application
APP_NAME=GRC_Claw API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Security
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
OIDC_ISSUER=https://auth.grc-claw.io
OIDC_AUDIENCE=https://api.grc-claw.io

# Database
DATABASE_URL=postgresql+asyncpg://grc:grc@localhost:5432/grc_claw
REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_DEFAULT_RPS=100
RATE_LIMIT_DEFAULT_BURST=200
RATE_LIMIT_ENFORCEMENT_RPS=10000
RATE_LIMIT_ENFORCEMENT_BURST=2000

# gRPC
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
GRPC_MAX_WORKERS=100

# Webhooks
WEBHOOK_MAX_RETRIES=6
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_TIMESTAMP_TOLERANCE=300

# Observability
OTEL_SERVICE_NAME=grc-claw-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO
ENABLE_METRICS=true
