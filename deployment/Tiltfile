# GRC_Claw — Tiltfile for Live-Reload Development
# Provides the fastest inner-loop: edit code → auto-rebuild → auto-deploy.
#
# Prerequisites:
#   - Tilt v0.30+
#   - kind or minikube cluster running
#   - kubectl configured to target the cluster
#
# Usage:
#   tilt up              # Start Tilt UI + live-reload
#   tilt up policy-api   # Only start specific resource
#   tilt down            # Tear down
#   tilt ci              # CI mode (no UI, fail on error)
#
# Environment:
#   TILT_HOST=127.0.0.1  # Bind Tilt UI to specific host
#   TILT_PORT=10350      # Tilt UI port

# ── Settings ─────────────────────────────────────────────────────────────────

settings({
    'auto_init': True,
    'k8s_telemetry': False,
    'trigger_mode': TRIGGER_MODE_AUTO,
    'enable_telemetry': False,
})

# ── Namespace ────────────────────────────────────────────────────────────────

allow_k8s_contexts([
    'kind-grc-claw',
    'minikube',
    'docker-desktop',
])

# ── Docker Compose (Data Layer) ──────────────────────────────────────────────

# Start the data layer via docker-compose for local dev speed
docker_compose('./docker-compose.yml')

# ── Kubernetes Resources ─────────────────────────────────────────────────────

# Load all K8s manifests
k8s_yaml([
    './grc-claw-deployment/kubernetes/namespaces',
    './grc-claw-deployment/kubernetes/data',
    './grc-claw-deployment/kubernetes/control-plane',
    './grc-claw-deployment/kubernetes/analytics',
    './grc-claw-deployment/kubernetes/evidence',
    './grc-claw-deployment/kubernetes/observability',
    './grc-claw-deployment/kubernetes/ingress',
    './grc-claw-deployment/kubernetes/network-policies',
    './grc-claw-deployment/kubernetes/resource-quotas.yaml',
    './grc-claw-deployment/kubernetes/pod-disruption-budgets',
])

# ── Custom Build ─────────────────────────────────────────────────────────────

# Build images from local Dockerfiles for live-reload

custom_build(
    'grc-claw/policy-api',
    './grc-claw-deployment/docker/policy-api',
    dockerfile='./grc-claw-deployment/docker/policy-api/Dockerfile',
    target='builder',
    live_update=[
        sync('./grc-claw-deployment/docker/policy-api', '/app'),
        run('pip install -r /app/requirements.txt', trigger='./grc-claw-deployment/docker/policy-api/requirements.txt'),
        restart_container(),
    ],
    entrypoint='python -m uvicorn app.main:app --host 0.0.0.0 --port 8080 --reload',
)

custom_build(
    'grc-claw/pdp-service',
    './grc-claw-deployment/docker/pdp-service',
    dockerfile='./grc-claw-deployment/docker/pdp-service/Dockerfile',
    target='builder',
    live_update=[
        sync('./grc-claw-deployment/docker/pdp-service', '/app'),
        run('go mod download', trigger='./grc-claw-deployment/docker/pdp-service/go.mod'),
        run('go build -o /app/server ./cmd/server', trigger='./grc-claw-deployment/docker/pdp-service'),
        restart_container(),
    ],
    entrypoint='/app/server',
)

custom_build(
    'grc-claw/pep-gateway',
    './grc-claw-deployment/docker/pep-gateway',
    dockerfile='./grc-claw-deployment/docker/pep-gateway/Dockerfile',
    target='builder',
    live_update=[
        sync('./grc-claw-deployment/docker/pep-gateway', '/app'),
        run('go mod download', trigger='./grc-claw-deployment/docker/pep-gateway/go.mod'),
        run('go build -o /app/server ./cmd/server', trigger='./grc-claw-deployment/docker/pep-gateway'),
        restart_container(),
    ],
    entrypoint='/app/server',
)

custom_build(
    'grc-claw/agent-identity',
    './grc-claw-deployment/docker/agent-identity',
    dockerfile='./grc-claw-deployment/docker/agent-identity/Dockerfile',
    target='builder',
    live_update=[
        sync('./grc-claw-deployment/docker/agent-identity', '/app'),
        run('go mod download', trigger='./grc-claw-deployment/docker/agent-identity/go.mod'),
