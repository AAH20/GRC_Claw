        restart_container(),
    ],
    entrypoint='python -m uvicorn app.main:app --host 0.0.0.0 --port 8080 --reload',
)

custom_build(
    'grc-claw/gateway',
    '.',
    dockerfile='./deploy/Dockerfile',
    target='build',
    live_update=[
        sync('./packages/gateway', '/app/packages/gateway'),
        run('npm install', trigger='./package.json'),
        run('npm run build', trigger='./packages/gateway'),
        restart_container(),
    ],
    entrypoint='node packages/gateway/dist/cli.js',
)

# ── Port Forwards ────────────────────────────────────────────────────────────

# Gateway
k8s_resource(
    'grc-claw-gateway',
    port_forwards=['18791:18791'],
    resource_deps=['policy-api', 'pdp-service', 'pep-gateway', 'agent-identity'],
)

# Grafana
k8s_resource(
    'grafana',
    port_forwards=['3000:3000'],
    resource_deps=['prometheus'],
)

# Prometheus
k8s_resource(
    'prometheus',
    port_forwards=['9090:9090'],
)

# Jaeger
k8s_resource(
    'jaeger',
    port_forwards=['16686:16686'],
)

# MinIO
k8s_resource(
    'minio',
    port_forwards=['9000:9000', '9001:9001'],
)

# Vault
k8s_resource(
    'vault',
    port_forwards=['8200:8200'],
)

# Control plane services
k8s_resource('policy-api', port_forwards=['8081:8080'])
k8s_resource('pdp-service', port_forwards=['8082:8080'])
k8s_resource('pep-gateway', port_forwards=['8083:8080'])
k8s_resource('agent-identity', port_forwards=['8084:8080'])

# Analytics
k8s_resource('analytics-engine', port_forwards=['8085:8080'])
k8s_resource('reporting-engine', port_forwards=['8086:8080'])

# Evidence
k8s_resource('evidence-collector', port_forwards=['8087:8080'])
k8s_resource('evidence-validator', port_forwards=['8088:8080'])
k8s_resource('compliance-mapping', port_forwards=['8089:8080'])

# ── Resource Groups ─────────────────────────────────────────────────────────

# Group resources by tier for the Tilt UI

local_resource(
    'init-db',
    cmd='./scripts/init-local-db.sh',
    deps=['./scripts/init-local-db.sh'],
    resource_deps=['postgres'],
)

local_resource(
    'seed-data',
    cmd='./scripts/seed-local-data.sh',
    deps=['./scripts/seed-local-data.sh'],
    resource_deps=['init-db'],
)

# ── Health Checks ────────────────────────────────────────────────────────────

# Wait for data layer before deploying services
k8s_resource(
    'postgres',
    readiness_probe={
        'exec': {
            'command': ['pg_isready', '-U', 'grc_claw', '-d', 'grc_claw'],
        },
        'period_secs': 5,
        'failure_threshold': 12,
    },
)

k8s_resource(
    'redis',
    readiness_probe={
        'exec': {
            'command': ['redis-cli', 'ping'],
        },
        'period_secs': 5,
        'failure_threshold': 12,
    },
)

k8s_resource(
    'kafka',
    readiness_probe={
        'exec': {
            'command': ['kafka-broker-api-versions', '--bootstrap-server', 'localhost:9092'],
        },
        'period_secs': 10,
        'failure_threshold': 12,
    },
)

# ── Environment ─────────────────────────────────────────────────────────────

# Load .env file for local development
dotenv('./.env.local')

# ── Extensions ───────────────────────────────────────────────────────────────

# Load Tilt extensions if present
load('ext://helm_resource', 'helm_resource')
load('ext://portforward', 'portforward')
