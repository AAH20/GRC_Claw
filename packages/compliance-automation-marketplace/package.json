{
  "name": "@grc-claw/compliance-automation-marketplace",
  "version": "1.0.0",
  "description": "Compliance automation marketplace for sharing, discovering, and monetizing compliance automations with ratings, versioning, and validation",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "grc",
    "compliance",
    "marketplace",
    "automation",
    "sharing",
    "monetization",
    "security"
  ],
  "author": "A2Z SOC",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AAH20/GRC_Claw"
  }
}
