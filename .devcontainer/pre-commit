#!/usr/bin/env bash
# GRC_Claw pre-commit hook
# Install: cp .devcontainer/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}Running pre-commit checks...${NC}"

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  echo -e "${GREEN}No staged files to check.${NC}"
  exit 0
fi

# Check for TypeScript/JavaScript files
TS_FILES=$(echo "$STAGED_FILES" | grep -E '\.(ts|tsx|js|jsx|mjs|cjs)$' || true)

if [ -n "$TS_FILES" ]; then
  echo -e "${YELLOW}Checking TypeScript files...${NC}"

  # Type check
  echo "Running TypeScript compiler..."
  npx tsc --noEmit --pretty

  # Lint staged files
  echo "Running ESLint..."
  echo "$TS_FILES" | xargs npx eslint --max-warnings=0

  # Format check
  echo "Checking formatting..."
  echo "$TS_FILES" | xargs npx prettier --check
fi

# Check for JSON files
JSON_FILES=$(echo "$STAGED_FILES" | grep -E '\.json$' || true)

if [ -n "$JSON_FILES" ]; then
  echo -e "${YELLOW}Validating JSON files...${NC}"
  echo "$JSON_FILES" | while read -r file; do
    if [ -f "$file" ]; then
      python3 -m json.tool "$file" > /dev/null || {
        echo -e "${RED}Invalid JSON: $file${NC}"
        exit 1
      }
    fi
  done
fi

# Check for YAML files
YAML_FILES=$(echo "$STAGED_FILES" | grep -E '\.(yml|yaml)$' || true)

if [ -n "$YAML_FILES" ]; then
  echo -e "${YELLOW}Validating YAML files...${NC}"
  echo "$YAML_FILES" | while read -r file; do
    if [ -f "$file" ]; then
      python3 -c "import yaml; yaml.safe_load(open('$file'))" || {
        echo -e "${RED}Invalid YAML: $file${NC}"
        exit 1
      }
    fi
  done
fi

# Check for Dockerfile changes
DOCKER_FILES=$(echo "$STAGED_FILES" | grep -i 'Dockerfile' || true)

if [ -n "$DOCKER_FILES" ]; then
  echo -e "${YELLOW}Checking Dockerfiles...${NC}"
  echo "$DOCKER_FILES" | while read -r file; do
    if [ -f "$file" ]; then
      # Basic Dockerfile validation
      if ! grep -q '^FROM ' "$file"; then
        echo -e "${RED}Missing FROM instruction: $file${NC}"
        exit 1
      fi
    fi
  done
fi

# Check for secrets (basic patterns)
echo -e "${YELLOW}Scanning for potential secrets...${NC}"
if echo "$STAGED_FILES" | xargs grep -lE '(api[_-]?key|secret|password|token|credential)\s*[=:]\s*["\x27][^"\x27]{8,}["\x27]' 2>/dev/null; then
  echo -e "${RED}Potential secrets found in staged files!${NC}"
  echo "Please review and use environment variables or a secrets manager."
  exit 1
fi

# Check for merge conflict markers
echo -e "${YELLOW}Checking for merge conflict markers...${NC}"
if echo "$STAGED_FILES" | xargs grep -lE '^(<<<<<<<|=======|>>>>>>>)' 2>/dev/null; then
  echo -e "${RED}Merge conflict markers found!${NC}"
  exit 1
fi

# Check for console.log in production code (warn only)
if [ -n "$TS_FILES" ]; then
  CONSOLE_LOGS=$(echo "$TS_FILES" | xargs grep -l 'console\.log' 2>/dev/null || true)
  if [ -n "$CONSOLE_LOGS" ]; then
    echo -e "${YELLOW}Warning: console.log found in:${NC}"
    echo "$CONSOLE_LOGS"
    echo -e "${YELLOW}Consider using a proper logger.${NC}"
  fi
fi

# Run tests if test files are staged
TEST_FILES=$(echo "$STAGED_FILES" | grep -E '\.(test|spec)\.(ts|js)$' || true)

if [ -n "$TEST_FILES" ]; then
  echo -e "${YELLOW}Running tests for staged test files...${NC}"
  echo "$TEST_FILES" | xargs npx vitest run --reporter=verbose
fi

echo -e "${GREEN}All pre-commit checks passed!${NC}"
exit 0
