  "title": "Social Media Manager - Grafana Dashboard",
  "uid": "social-media-manager",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "social-media-manager-alert-1",
        "title": "Negative Sentiment Spike",
        "condition": "sentiment_score < 0.3",
        "severity": "critical",
        "message": "Negative sentiment detected",
        "for": "5m",
        "labels": {
          "project": "social-media-manager",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Negative sentiment detected"
        }
      },
      {
        "uid": "social-media-manager-alert-2",
        "title": "Low Engagement",
        "condition": "engagement_rate < 0.02",
        "severity": "warning",
        "message": "Engagement rate below 2%",
        "for": "5m",
        "labels": {
          "project": "social-media-manager",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Engagement rate below 2%"
        }
      },
      {
        "uid": "social-media-manager-alert-3",
        "title": "Follower Churn",
        "condition": "rate(followers_total[1d]) < -100",
        "severity": "warning",
        "message": "Significant follower loss",
        "for": "5m",
        "labels": {
          "project": "social-media-manager",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Significant follower loss"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "social-media-manager-default-policy",
        "name": "Social Media Manager Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "social-media-manager-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "social-media-manager-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
}