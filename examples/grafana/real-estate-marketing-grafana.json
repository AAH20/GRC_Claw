  "alerting": {
    "rules": [
      {
        "uid": "real-estate-marketing-alert-1",
        "title": "Low Lead Generation",
        "condition": "lead_generation_rate < 5",
        "severity": "warning",
        "message": "Lead generation below 5/min",
        "for": "5m",
        "labels": {
          "project": "real-estate-marketing",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Lead generation below 5/min"
        }
      },
      {
        "uid": "real-estate-marketing-alert-2",
        "title": "Low Inquiry Rate",
        "condition": "inquiry_rate < 0.05",
        "severity": "warning",
        "message": "Inquiry rate below 5%",
        "for": "5m",
        "labels": {
          "project": "real-estate-marketing",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Inquiry rate below 5%"
        }
      },
      {
        "uid": "real-estate-marketing-alert-3",
        "title": "High Time on Market",
        "condition": "time_on_market_days > 60",
        "severity": "warning",
        "message": "Time on market above 60 days",
        "for": "5m",
        "labels": {
          "project": "real-estate-marketing",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Time on market above 60 days"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "real-estate-marketing-default-policy",
        "name": "Real Estate Marketing Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "real-estate-marketing-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "real-estate-marketing-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
