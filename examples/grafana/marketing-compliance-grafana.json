  "timepicker": {},
  "timezone": "",
  "title": "Marketing Compliance - Grafana Dashboard",
  "uid": "marketing-compliance",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "marketing-compliance-alert-1",
        "title": "Compliance Breach",
        "condition": "compliance_score < 0.95",
        "severity": "critical",
        "message": "Compliance score below 95%",
        "for": "5m",
        "labels": {
          "project": "marketing-compliance",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Compliance score below 95%"
        }
      },
      {
        "uid": "marketing-compliance-alert-2",
        "title": "High Violation Count",
        "condition": "violation_count > 10",
        "severity": "critical",
        "message": "More than 10 violations detected",
        "for": "5m",
        "labels": {
          "project": "marketing-compliance",
          "severity": "critical"
        },
        "annotations": {
          "summary": "More than 10 violations detected"
        }
      },
      {
        "uid": "marketing-compliance-alert-3",
        "title": "Low Consent Rate",
        "condition": "consent_rate < 0.8",
        "severity": "warning",
        "message": "Consent rate below 80%",
        "for": "5m",
        "labels": {
          "project": "marketing-compliance",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Consent rate below 80%"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "marketing-compliance-default-policy",
        "name": "Marketing Compliance Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "marketing-compliance-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "marketing-compliance-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
