  "title": "Onboarding & Training - Grafana Dashboard",
  "uid": "onboarding-training",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "onboarding-training-alert-1",
        "title": "Low Completion",
        "condition": "completion_rate < 0.7",
        "severity": "warning",
        "message": "Completion rate below 70%",
        "for": "5m",
        "labels": {
          "project": "onboarding-training",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Completion rate below 70%"
        }
      },
      {
        "uid": "onboarding-training-alert-2",
        "title": "Slow Progress",
        "condition": "time_to_competency_days > 30",
        "severity": "warning",
        "message": "Time to competency above 30 days",
        "for": "5m",
        "labels": {
          "project": "onboarding-training",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Time to competency above 30 days"
        }
      },
      {
        "uid": "onboarding-training-alert-3",
        "title": "Low Satisfaction",
        "condition": "satisfaction_score < 0.7",
        "severity": "critical",
        "message": "Satisfaction score below 70%",
        "for": "5m",
        "labels": {
          "project": "onboarding-training",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Satisfaction score below 70%"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "onboarding-training-default-policy",
        "name": "Onboarding & Training Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "onboarding-training-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "onboarding-training-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
