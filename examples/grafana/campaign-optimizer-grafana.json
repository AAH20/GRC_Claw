  "timepicker": {},
  "timezone": "",
  "title": "Campaign Optimizer - Grafana Dashboard",
  "uid": "campaign-optimizer",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "campaign-optimizer-alert-1",
        "title": "Low CTR Alert",
        "condition": "ctr < 1.0",
        "severity": "warning",
        "message": "CTR dropped below 1%",
        "for": "5m",
        "labels": {
          "project": "campaign-optimizer",
          "severity": "warning"
        },
        "annotations": {
          "summary": "CTR dropped below 1%"
        }
      },
      {
        "uid": "campaign-optimizer-alert-2",
        "title": "High CPC Alert",
        "condition": "cpc > 5.0",
        "severity": "critical",
        "message": "CPC exceeded $5.00",
        "for": "5m",
        "labels": {
          "project": "campaign-optimizer",
          "severity": "critical"
        },
        "annotations": {
          "summary": "CPC exceeded $5.00"
        }
      },
      {
        "uid": "campaign-optimizer-alert-3",
        "title": "Low ROAS Alert",
        "condition": "roas < 2.0",
        "severity": "critical",
        "message": "ROAS below 2.0x",
        "for": "5m",
        "labels": {
          "project": "campaign-optimizer",
          "severity": "critical"
        },
        "annotations": {
          "summary": "ROAS below 2.0x"
        }
      },
      {
        "uid": "campaign-optimizer-alert-4",
        "title": "Budget Exhaustion",
        "condition": "budget_utilization > 90",
        "severity": "warning",
        "message": "Budget 90% exhausted",
        "for": "5m",
        "labels": {
          "project": "campaign-optimizer",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Budget 90% exhausted"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "campaign-optimizer-default-policy",
        "name": "Campaign Optimizer Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "campaign-optimizer-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "campaign-optimizer-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
