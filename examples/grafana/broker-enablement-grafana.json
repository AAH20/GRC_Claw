  "timepicker": {},
  "timezone": "",
  "title": "Broker Enablement - Grafana Dashboard",
  "uid": "broker-enablement",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "broker-enablement-alert-1",
        "title": "Compliance Breach",
        "condition": "compliance_score < 0.9",
        "severity": "critical",
        "message": "Compliance score below 90%",
        "for": "5m",
        "labels": {
          "project": "broker-enablement",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Compliance score below 90%"
        }
      },
      {
        "uid": "broker-enablement-alert-2",
        "title": "License Expiry",
        "condition": "license_status == \"expiring\"",
        "severity": "warning",
        "message": "Licenses expiring soon",
        "for": "5m",
        "labels": {
          "project": "broker-enablement",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Licenses expiring soon"
        }
      },
      {
        "uid": "broker-enablement-alert-3",
        "title": "Low Training Completion",
        "condition": "training_completion_rate < 0.7",
        "severity": "warning",
        "message": "Training completion below 70%",
        "for": "5m",
        "labels": {
          "project": "broker-enablement",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Training completion below 70%"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "broker-enablement-default-policy",
        "name": "Broker Enablement Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "broker-enablement-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "broker-enablement-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
}