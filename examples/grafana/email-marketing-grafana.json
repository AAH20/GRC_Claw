  },
  "timepicker": {},
  "timezone": "",
  "title": "Email Marketing - Grafana Dashboard",
  "uid": "email-marketing",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "email-marketing-alert-1",
        "title": "High Bounce Rate",
        "condition": "bounce_rate > 0.05",
        "severity": "critical",
        "message": "Bounce rate exceeds 5%",
        "for": "5m",
        "labels": {
          "project": "email-marketing",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Bounce rate exceeds 5%"
        }
      },
      {
        "uid": "email-marketing-alert-2",
        "title": "High Unsubscribe Rate",
        "condition": "unsubscribe_rate > 0.02",
        "severity": "warning",
        "message": "Unsubscribe rate above 2%",
        "for": "5m",
        "labels": {
          "project": "email-marketing",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Unsubscribe rate above 2%"
        }
      },
      {
        "uid": "email-marketing-alert-3",
        "title": "Low Open Rate",
        "condition": "open_rate < 0.15",
        "severity": "warning",
        "message": "Open rate below 15%",
        "for": "5m",
        "labels": {
          "project": "email-marketing",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Open rate below 15%"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "email-marketing-default-policy",
        "name": "Email Marketing Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "email-marketing-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "email-marketing-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
}