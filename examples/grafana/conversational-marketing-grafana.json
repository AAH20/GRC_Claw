        },
        "hide": 0,
        "label": "Data Source",
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      },
      {
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(project)",
        "hide": 0,
        "includeAll": true,
        "label": "Project",
        "multi": true,
        "name": "project",
        "options": [],
        "query": {
          "query": "label_values(project)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Conversational Marketing - Grafana Dashboard",
  "uid": "conversational-marketing",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "conversational-marketing-alert-1",
        "title": "Low Resolution Rate",
        "condition": "resolution_rate < 0.7",
        "severity": "critical",
        "message": "Resolution rate below 70%",
        "for": "5m",
        "labels": {
          "project": "conversational-marketing",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Resolution rate below 70%"
        }
      },
      {
        "uid": "conversational-marketing-alert-2",
        "title": "High Handoff Rate",
        "condition": "handoff_rate > 0.4",
        "severity": "warning",
        "message": "Handoff rate above 40%",
        "for": "5m",
        "labels": {
          "project": "conversational-marketing",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Handoff rate above 40%"
        }
      },
      {
        "uid": "conversational-marketing-alert-3",
        "title": "Slow Response",
        "condition": "bot_response_time_seconds > 5",
        "severity": "warning",
        "message": "Bot response time above 5s",
        "for": "5m",
        "labels": {
          "project": "conversational-marketing",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Bot response time above 5s"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "conversational-marketing-default-policy",
        "name": "Conversational Marketing Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "conversational-marketing-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "conversational-marketing-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
}