  "title": "Event Management - Grafana Dashboard",
  "uid": "event-management",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "event-management-alert-1",
        "title": "Low Registration",
        "condition": "registration_rate < 10",
        "severity": "warning",
        "message": "Registration rate below 10/min",
        "for": "5m",
        "labels": {
          "project": "event-management",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Registration rate below 10/min"
        }
      },
      {
        "uid": "event-management-alert-2",
        "title": "Low Attendance",
        "condition": "attendance_rate < 0.6",
        "severity": "warning",
        "message": "Attendance rate below 60%",
        "for": "5m",
        "labels": {
          "project": "event-management",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Attendance rate below 60%"
        }
      },
      {
        "uid": "event-management-alert-3",
        "title": "Low Satisfaction",
        "condition": "satisfaction_score < 0.7",
        "severity": "critical",
        "message": "Satisfaction score below 70%",
        "for": "5m",
        "labels": {
          "project": "event-management",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Satisfaction score below 70%"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "event-management-default-policy",
        "name": "Event Management Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "event-management-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "event-management-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
