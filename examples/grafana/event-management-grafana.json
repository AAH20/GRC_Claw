      "targets": [
        {
          "refId": "A",
          "expr": "rate(registrations_total[5m])",
          "legendFormat": "Registration Rate",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
