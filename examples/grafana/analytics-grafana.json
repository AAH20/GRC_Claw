          "value": "prometheus"
        },
        "hide": 0,
        "label": "Data Source",
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      },
      {
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(project)",
        "hide": 0,
        "includeAll": true,
        "label": "Project",
        "multi": true,
        "name": "project",
        "options": [],
        "query": {
          "query": "label_values(project)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Analytics - Grafana Dashboard",
  "uid": "analytics",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "analytics-alert-1",
        "title": "Data Freshness Issue",
        "condition": "data_freshness_seconds > 3600",
        "severity": "critical",
        "message": "Data stale for over 1 hour",
        "for": "5m",
        "labels": {
          "project": "analytics",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Data stale for over 1 hour"
        }
      },
      {
        "uid": "analytics-alert-2",
        "title": "High Pipeline Error",
        "condition": "error_rate > 0.05",
        "severity": "critical",
        "message": "Pipeline error rate above 5%",
        "for": "5m",
        "labels": {
          "project": "analytics",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Pipeline error rate above 5%"
        }
      },
      {
        "uid": "analytics-alert-3",
        "title": "Low Coverage",
        "condition": "data_coverage < 0.9",
        "severity": "warning",
        "message": "Data coverage below 90%",
        "for": "5m",
        "labels": {
          "project": "analytics",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Data coverage below 90%"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "analytics-default-policy",
        "name": "Analytics Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "analytics-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "analytics-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
}