        },
        "hide": 0,
        "label": "Data Source",
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      },
      {
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(project)",
        "hide": 0,
        "includeAll": true,
        "label": "Project",
        "multi": true,
        "name": "project",
        "options": [],
        "query": {
          "query": "label_values(project)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Content Generator - Grafana Dashboard",
  "uid": "content-generator",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "content-generator-alert-1",
        "title": "Low Quality Score",
        "condition": "content_quality_score < 0.7",
        "severity": "critical",
        "message": "Content quality score below 70%",
        "for": "5m",
        "labels": {
          "project": "content-generator",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Content quality score below 70%"
        }
      },
      {
        "uid": "content-generator-alert-2",
        "title": "High Generation Failure",
        "condition": "rate(generation_failures_total[5m]) > 0.1",
        "severity": "critical",
        "message": "Content generation failure rate high",
        "for": "5m",
        "labels": {
          "project": "content-generator",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Content generation failure rate high"
        }
      },
      {
        "uid": "content-generator-alert-3",
        "title": "High Token Usage",
        "condition": "rate(token_usage_total[5m]) > 10000",
        "severity": "warning",
        "message": "Token usage exceeding threshold",
        "for": "5m",
        "labels": {
          "project": "content-generator",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Token usage exceeding threshold"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "content-generator-default-policy",
        "name": "Content Generator Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "content-generator-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "content-generator-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
}