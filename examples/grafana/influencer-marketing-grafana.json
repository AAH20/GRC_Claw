  "title": "Influencer Marketing - Grafana Dashboard",
  "uid": "influencer-marketing",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "influencer-marketing-alert-1",
        "title": "Low Authenticity",
        "condition": "authenticity_score < 0.7",
        "severity": "critical",
        "message": "Authenticity score below 70%",
        "for": "5m",
        "labels": {
          "project": "influencer-marketing",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Authenticity score below 70%"
        }
      },
      {
        "uid": "influencer-marketing-alert-2",
        "title": "High CPE",
        "condition": "cost_per_engagement > 5",
        "severity": "warning",
        "message": "Cost per engagement above $5",
        "for": "5m",
        "labels": {
          "project": "influencer-marketing",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Cost per engagement above $5"
        }
      },
      {
        "uid": "influencer-marketing-alert-3",
        "title": "Negative Sentiment",
        "condition": "negative_sentiment_rate > 0.3",
        "severity": "critical",
        "message": "Negative sentiment above 30%",
        "for": "5m",
        "labels": {
          "project": "influencer-marketing",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Negative sentiment above 30%"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "influencer-marketing-default-policy",
        "name": "Influencer Marketing Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "influencer-marketing-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "influencer-marketing-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
