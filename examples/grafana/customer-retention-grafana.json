  "title": "Customer Retention - Grafana Dashboard",
  "uid": "customer-retention",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "customer-retention-alert-1",
        "title": "High Churn Rate",
        "condition": "churn_rate > 0.1",
        "severity": "critical",
        "message": "Churn rate above 10%",
        "for": "5m",
        "labels": {
          "project": "customer-retention",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Churn rate above 10%"
        }
      },
      {
        "uid": "customer-retention-alert-2",
        "title": "Low Retention",
        "condition": "retention_rate < 0.8",
        "severity": "critical",
        "message": "Retention rate below 80%",
        "for": "5m",
        "labels": {
          "project": "customer-retention",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Retention rate below 80%"
        }
      },
      {
        "uid": "customer-retention-alert-3",
        "title": "NPS Drop",
        "condition": "nps_score < 30",
        "severity": "warning",
        "message": "NPS below 30",
        "for": "5m",
        "labels": {
          "project": "customer-retention",
          "severity": "warning"
        },
        "annotations": {
          "summary": "NPS below 30"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "customer-retention-default-policy",
        "name": "Customer Retention Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "customer-retention-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "customer-retention-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
