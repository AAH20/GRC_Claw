  "uid": "smb-marketing",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "smb-marketing-alert-1",
        "title": "Low Visibility",
        "condition": "local_visibility_score < 0.6",
        "severity": "warning",
        "message": "Local visibility below 60%",
        "for": "5m",
        "labels": {
          "project": "smb-marketing",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Local visibility below 60%"
        }
      },
      {
        "uid": "smb-marketing-alert-2",
        "title": "Low Review Rating",
        "condition": "review_rating < 3.5",
        "severity": "critical",
        "message": "Review rating below 3.5",
        "for": "5m",
        "labels": {
          "project": "smb-marketing",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Review rating below 3.5"
        }
      },
      {
        "uid": "smb-marketing-alert-3",
        "title": "High CAC",
        "condition": "customer_acquisition_cost > 200",
        "severity": "warning",
        "message": "CAC above $200",
        "for": "5m",
        "labels": {
          "project": "smb-marketing",
          "severity": "warning"
        },
        "annotations": {
          "summary": "CAC above $200"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "smb-marketing-default-policy",
        "name": "SMB Marketing Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "smb-marketing-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "smb-marketing-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
