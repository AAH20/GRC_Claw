  "alerting": {
    "rules": [
      {
        "uid": "healthcare-marketing-alert-1",
        "title": "Compliance Breach",
        "condition": "healthcare_compliance_score < 0.95",
        "severity": "critical",
        "message": "Compliance score below 95%",
        "for": "5m",
        "labels": {
          "project": "healthcare-marketing",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Compliance score below 95%"
        }
      },
      {
        "uid": "healthcare-marketing-alert-2",
        "title": "High PAC",
        "condition": "patient_acquisition_cost > 500",
        "severity": "warning",
        "message": "Patient acquisition cost above $500",
        "for": "5m",
        "labels": {
          "project": "healthcare-marketing",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Patient acquisition cost above $500"
        }
      },
      {
        "uid": "healthcare-marketing-alert-3",
        "title": "Low Satisfaction",
        "condition": "patient_satisfaction < 0.8",
        "severity": "critical",
        "message": "Patient satisfaction below 80%",
        "for": "5m",
        "labels": {
          "project": "healthcare-marketing",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Patient satisfaction below 80%"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "healthcare-marketing-default-policy",
        "name": "Healthcare Marketing Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "healthcare-marketing-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "healthcare-marketing-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
