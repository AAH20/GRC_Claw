      "id": 1,
      "title": "Patient Acquisition Cost",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg(patient_acquisition_cost)",
          "legendFormat": "Patient Acquisition Cost",
