  "title": "SaaS Marketing - Grafana Dashboard",
  "uid": "saas-marketing",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "saas-marketing-alert-1",
        "title": "Low MQL Rate",
        "condition": "mql_rate < 10",
        "severity": "warning",
        "message": "MQL rate below 10/min",
        "for": "5m",
        "labels": {
          "project": "saas-marketing",
          "severity": "warning"
        },
        "annotations": {
          "summary": "MQL rate below 10/min"
        }
      },
      {
        "uid": "saas-marketing-alert-2",
        "title": "High Churn",
        "condition": "saas_churn_rate > 0.05",
        "severity": "critical",
        "message": "Churn rate above 5%",
        "for": "5m",
        "labels": {
          "project": "saas-marketing",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Churn rate above 5%"
        }
      },
      {
        "uid": "saas-marketing-alert-3",
        "title": "Low LTV:CAC Ratio",
        "condition": "ltv_cac_ratio < 3",
        "severity": "critical",
        "message": "LTV:CAC ratio below 3",
        "for": "5m",
        "labels": {
          "project": "saas-marketing",
          "severity": "critical"
        },
        "annotations": {
          "summary": "LTV:CAC ratio below 3"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "saas-marketing-default-policy",
        "name": "SaaS Marketing Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "saas-marketing-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "saas-marketing-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
