  "alerting": {
    "rules": [
      {
        "uid": "agency-marketing-alert-1",
        "title": "Low Retention",
        "condition": "client_retention_rate < 0.85",
        "severity": "critical",
        "message": "Client retention below 85%",
        "for": "5m",
        "labels": {
          "project": "agency-marketing",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Client retention below 85%"
        }
      },
      {
        "uid": "agency-marketing-alert-2",
        "title": "Low Utilization",
        "condition": "utilization_rate < 0.7",
        "severity": "warning",
        "message": "Utilization rate below 70%",
        "for": "5m",
        "labels": {
          "project": "agency-marketing",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Utilization rate below 70%"
        }
      },
      {
        "uid": "agency-marketing-alert-3",
        "title": "Low Satisfaction",
        "condition": "client_satisfaction < 0.8",
        "severity": "critical",
        "message": "Client satisfaction below 80%",
        "for": "5m",
        "labels": {
          "project": "agency-marketing",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Client satisfaction below 80%"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "agency-marketing-default-policy",
        "name": "Agency Marketing Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "agency-marketing-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "agency-marketing-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
