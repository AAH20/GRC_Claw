  },
  "timepicker": {},
  "timezone": "",
  "title": "Feedback Management - Grafana Dashboard",
  "uid": "feedback-management",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "feedback-management-alert-1",
        "title": "Negative Sentiment",
        "condition": "sentiment_score < 0.4",
        "severity": "critical",
        "message": "Sentiment score below 40%",
        "for": "5m",
        "labels": {
          "project": "feedback-management",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Sentiment score below 40%"
        }
      },
      {
        "uid": "feedback-management-alert-2",
        "title": "Low Response Rate",
        "condition": "response_rate < 0.6",
        "severity": "warning",
        "message": "Response rate below 60%",
        "for": "5m",
        "labels": {
          "project": "feedback-management",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Response rate below 60%"
        }
      },
      {
        "uid": "feedback-management-alert-3",
        "title": "High Volume",
        "condition": "rate(feedback_received_total[1h]) > 1000",
        "severity": "warning",
        "message": "Feedback volume spike detected",
        "for": "5m",
        "labels": {
          "project": "feedback-management",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Feedback volume spike detected"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "feedback-management-default-policy",
        "name": "Feedback Management Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "feedback-management-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "feedback-management-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
}