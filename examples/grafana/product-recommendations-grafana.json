        "label": "Data Source",
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      },
      {
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(project)",
        "hide": 0,
        "includeAll": true,
        "label": "Project",
        "multi": true,
        "name": "project",
        "options": [],
        "query": {
          "query": "label_values(project)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Product Recommendations - Grafana Dashboard",
  "uid": "product-recommendations",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "product-recommendations-alert-1",
        "title": "Low CTR",
        "condition": "rec_ctr < 0.05",
        "severity": "warning",
        "message": "Recommendation CTR below 5%",
        "for": "5m",
        "labels": {
          "project": "product-recommendations",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Recommendation CTR below 5%"
        }
      },
      {
        "uid": "product-recommendations-alert-2",
        "title": "Low Relevance",
        "condition": "relevance_score < 0.6",
        "severity": "critical",
        "message": "Relevance score below 60%",
        "for": "5m",
        "labels": {
          "project": "product-recommendations",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Relevance score below 60%"
        }
      },
      {
        "uid": "product-recommendations-alert-3",
        "title": "Revenue Drop",
        "condition": "revenue_lift < 0.1",
        "severity": "warning",
        "message": "Revenue lift below 10%",
        "for": "5m",
        "labels": {
          "project": "product-recommendations",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Revenue lift below 10%"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "product-recommendations-default-policy",
        "name": "Product Recommendations Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "product-recommendations-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "product-recommendations-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
