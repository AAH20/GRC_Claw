  "timepicker": {},
  "timezone": "",
  "title": "Sales Automator - Grafana Dashboard",
  "uid": "sales-automator",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "sales-automator-alert-1",
        "title": "High Error Rate",
        "condition": "error_rate > 0.05",
        "severity": "critical",
        "message": "Workflow error rate above 5%",
        "for": "5m",
        "labels": {
          "project": "sales-automator",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Workflow error rate above 5%"
        }
      },
      {
        "uid": "sales-automator-alert-2",
        "title": "Low Completion Rate",
        "condition": "task_completion_rate < 0.7",
        "severity": "warning",
        "message": "Task completion below 70%",
        "for": "5m",
        "labels": {
          "project": "sales-automator",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Task completion below 70%"
        }
      },
      {
        "uid": "sales-automator-alert-3",
        "title": "Workflow Bottleneck",
        "condition": "throughput < 10",
        "severity": "warning",
        "message": "Workflow throughput bottleneck detected",
        "for": "5m",
        "labels": {
          "project": "sales-automator",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Workflow throughput bottleneck detected"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "sales-automator-default-policy",
        "name": "Sales Automator Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "sales-automator-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "sales-automator-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
}