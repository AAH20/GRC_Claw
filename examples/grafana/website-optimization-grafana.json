  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Website Optimization - Grafana Dashboard",
  "uid": "website-optimization",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "website-optimization-alert-1",
        "title": "Slow Page Speed",
        "condition": "page_load_time_seconds > 3",
        "severity": "critical",
        "message": "Page load time above 3s",
        "for": "5m",
        "labels": {
          "project": "website-optimization",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Page load time above 3s"
        }
      },
      {
        "uid": "website-optimization-alert-2",
        "title": "Low Uptime",
        "condition": "uptime_percentage < 0.99",
        "severity": "critical",
        "message": "Uptime below 99%",
        "for": "5m",
        "labels": {
          "project": "website-optimization",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Uptime below 99%"
        }
      },
      {
        "uid": "website-optimization-alert-3",
        "title": "High Bounce Rate",
        "condition": "bounce_rate > 0.6",
        "severity": "warning",
        "message": "Bounce rate above 60%",
        "for": "5m",
        "labels": {
          "project": "website-optimization",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Bounce rate above 60%"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "website-optimization-default-policy",
        "name": "Website Optimization Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "website-optimization-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "website-optimization-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
}