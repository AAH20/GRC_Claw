  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "PPC Manager - Grafana Dashboard",
  "uid": "ppc-manager",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "ppc-manager-alert-1",
        "title": "High CPC",
        "condition": "cpc > 10",
        "severity": "critical",
        "message": "CPC exceeded $10",
        "for": "5m",
        "labels": {
          "project": "ppc-manager",
          "severity": "critical"
        },
        "annotations": {
          "summary": "CPC exceeded $10"
        }
      },
      {
        "uid": "ppc-manager-alert-2",
        "title": "Low Impression Share",
        "condition": "impression_share < 0.5",
        "severity": "warning",
        "message": "Impression share below 50%",
        "for": "5m",
        "labels": {
          "project": "ppc-manager",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Impression share below 50%"
        }
      },
      {
        "uid": "ppc-manager-alert-3",
        "title": "Budget Overspend",
        "condition": "budget_pace > 1.1",
        "severity": "critical",
        "message": "Budget overspend detected",
        "for": "5m",
        "labels": {
          "project": "ppc-manager",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Budget overspend detected"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "ppc-manager-default-policy",
        "name": "PPC Manager Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "ppc-manager-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "ppc-manager-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
}