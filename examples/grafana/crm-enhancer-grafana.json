  "timezone": "",
  "title": "CRM Enhancer - Grafana Dashboard",
  "uid": "crm-enhancer",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "crm-enhancer-alert-1",
        "title": "Low Data Quality",
        "condition": "data_quality_score < 0.8",
        "severity": "critical",
        "message": "CRM data quality below 80%",
        "for": "5m",
        "labels": {
          "project": "crm-enhancer",
          "severity": "critical"
        },
        "annotations": {
          "summary": "CRM data quality below 80%"
        }
      },
      {
        "uid": "crm-enhancer-alert-2",
        "title": "High Duplicate Rate",
        "condition": "duplicate_rate > 0.1",
        "severity": "warning",
        "message": "Duplicate rate above 10%",
        "for": "5m",
        "labels": {
          "project": "crm-enhancer",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Duplicate rate above 10%"
        }
      },
      {
        "uid": "crm-enhancer-alert-3",
        "title": "Sync Failure",
        "condition": "crm_sync_status != 1",
        "severity": "critical",
        "message": "CRM sync failure detected",
        "for": "5m",
        "labels": {
          "project": "crm-enhancer",
          "severity": "critical"
        },
        "annotations": {
          "summary": "CRM sync failure detected"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "crm-enhancer-default-policy",
        "name": "CRM Enhancer Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "crm-enhancer-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "crm-enhancer-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
}