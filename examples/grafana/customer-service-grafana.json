  "templating": {
    "list": [
      {
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 0,
        "label": "Data Source",
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      },
      {
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(project)",
        "hide": 0,
        "includeAll": true,
        "label": "Project",
        "multi": true,
        "name": "project",
        "options": [],
        "query": {
          "query": "label_values(project)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Customer Service - Grafana Dashboard",
  "uid": "customer-service",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "customer-service-alert-1",
        "title": "High Response Time",
        "condition": "first_response_time_seconds > 300",
        "severity": "critical",
        "message": "Response time above 5 minutes",
        "for": "5m",
        "labels": {
          "project": "customer-service",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Response time above 5 minutes"
        }
      },
      {
        "uid": "customer-service-alert-2",
        "title": "Low CSAT",
        "condition": "csat_score < 0.7",
        "severity": "critical",
        "message": "CSAT below 70%",
        "for": "5m",
        "labels": {
          "project": "customer-service",
          "severity": "critical"
        },
        "annotations": {
          "summary": "CSAT below 70%"
        }
      },
      {
        "uid": "customer-service-alert-3",
        "title": "Backlog Spike",
        "condition": "open_tickets > 500",
        "severity": "warning",
        "message": "Ticket backlog exceeds 500",
        "for": "5m",
        "labels": {
          "project": "customer-service",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Ticket backlog exceeds 500"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "customer-service-default-policy",
        "name": "Customer Service Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "customer-service-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "customer-service-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
}