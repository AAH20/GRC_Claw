  "title": "Marketing Attribution - Grafana Dashboard",
  "uid": "marketing-attribution",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "marketing-attribution-alert-1",
        "title": "Low Attribution Accuracy",
        "condition": "attribution_accuracy < 0.7",
        "severity": "critical",
        "message": "Attribution accuracy below 70%",
        "for": "5m",
        "labels": {
          "project": "marketing-attribution",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Attribution accuracy below 70%"
        }
      },
      {
        "uid": "marketing-attribution-alert-2",
        "title": "Low Model Confidence",
        "condition": "model_confidence < 0.6",
        "severity": "warning",
        "message": "Model confidence below 60%",
        "for": "5m",
        "labels": {
          "project": "marketing-attribution",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Model confidence below 60%"
        }
      },
      {
        "uid": "marketing-attribution-alert-3",
        "title": "Channel Discrepancy",
        "condition": "channel_contribution_variance > 0.3",
        "severity": "warning",
        "message": "Channel contribution variance high",
        "for": "5m",
        "labels": {
          "project": "marketing-attribution",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Channel contribution variance high"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "marketing-attribution-default-policy",
        "name": "Marketing Attribution Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "marketing-attribution-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "marketing-attribution-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
