  "timezone": "",
  "title": "Customer Segmentation - Grafana Dashboard",
  "uid": "customer-segmentation",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "customer-segmentation-alert-1",
        "title": "High Migration Rate",
        "condition": "migration_rate > 0.1",
        "severity": "warning",
        "message": "Segment migration rate above 10%",
        "for": "5m",
        "labels": {
          "project": "customer-segmentation",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Segment migration rate above 10%"
        }
      },
      {
        "uid": "customer-segmentation-alert-2",
        "title": "Low Targeting Accuracy",
        "condition": "targeting_accuracy < 0.75",
        "severity": "critical",
        "message": "Targeting accuracy below 75%",
        "for": "5m",
        "labels": {
          "project": "customer-segmentation",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Targeting accuracy below 75%"
        }
      },
      {
        "uid": "customer-segmentation-alert-3",
        "title": "Segment Overlap",
        "condition": "segment_overlap_rate > 0.3",
        "severity": "warning",
        "message": "Segment overlap above 30%",
        "for": "5m",
        "labels": {
          "project": "customer-segmentation",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Segment overlap above 30%"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "customer-segmentation-default-policy",
        "name": "Customer Segmentation Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "customer-segmentation-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "customer-segmentation-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
