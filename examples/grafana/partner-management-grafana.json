  "title": "Partner Management - Grafana Dashboard",
  "uid": "partner-management",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "partner-management-alert-1",
        "title": "Low Engagement",
        "condition": "partner_engagement_score < 0.5",
        "severity": "warning",
        "message": "Partner engagement below 50%",
        "for": "5m",
        "labels": {
          "project": "partner-management",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Partner engagement below 50%"
        }
      },
      {
        "uid": "partner-management-alert-2",
        "title": "Low Pipeline",
        "condition": "partner_pipeline_total < 100000",
        "severity": "warning",
        "message": "Partner pipeline below $100K",
        "for": "5m",
        "labels": {
          "project": "partner-management",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Partner pipeline below $100K"
        }
      },
      {
        "uid": "partner-management-alert-3",
        "title": "Low Satisfaction",
        "condition": "partner_satisfaction < 0.7",
        "severity": "critical",
        "message": "Partner satisfaction below 70%",
        "for": "5m",
        "labels": {
          "project": "partner-management",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Partner satisfaction below 70%"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "partner-management-default-policy",
        "name": "Partner Management Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "partner-management-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "partner-management-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
