  "uid": "account-based-marketing",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "account-based-marketing-alert-1",
        "title": "Low Engagement",
        "condition": "account_engagement_score < 0.4",
        "severity": "warning",
        "message": "Account engagement below 40%",
        "for": "5m",
        "labels": {
          "project": "account-based-marketing",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Account engagement below 40%"
        }
      },
      {
        "uid": "account-based-marketing-alert-2",
        "title": "Low Intent",
        "condition": "intent_score < 0.5",
        "severity": "warning",
        "message": "Intent score below 50%",
        "for": "5m",
        "labels": {
          "project": "account-based-marketing",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Intent score below 50%"
        }
      },
      {
        "uid": "account-based-marketing-alert-3",
        "title": "Pipeline Stagnation",
        "condition": "pipeline_influence < 0.3",
        "severity": "critical",
        "message": "Pipeline influence below 30%",
        "for": "5m",
        "labels": {
          "project": "account-based-marketing",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Pipeline influence below 30%"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "account-based-marketing-default-policy",
        "name": "Account-Based Marketing Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "account-based-marketing-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "account-based-marketing-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
