  "title": "Journey Orchestrator - Grafana Dashboard",
  "uid": "journey-orchestrator",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "journey-orchestrator-alert-1",
        "title": "High Drop-off Rate",
        "condition": "drop_off_rate > 0.5",
        "severity": "critical",
        "message": "Journey drop-off rate exceeds 50%",
        "for": "5m",
        "labels": {
          "project": "journey-orchestrator",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Journey drop-off rate exceeds 50%"
        }
      },
      {
        "uid": "journey-orchestrator-alert-2",
        "title": "Low Completion Rate",
        "condition": "journey_completion_rate < 0.3",
        "severity": "warning",
        "message": "Journey completion below 30%",
        "for": "5m",
        "labels": {
          "project": "journey-orchestrator",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Journey completion below 30%"
        }
      },
      {
        "uid": "journey-orchestrator-alert-3",
        "title": "Orchestration Latency",
        "condition": "orchestration_latency_ms > 5000",
        "severity": "warning",
        "message": "Orchestration latency above 5s",
        "for": "5m",
        "labels": {
          "project": "journey-orchestrator",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Orchestration latency above 5s"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "journey-orchestrator-default-policy",
        "name": "Journey Orchestrator Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "journey-orchestrator-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "journey-orchestrator-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
