  "title": "Pricing Optimizer - Grafana Dashboard",
  "uid": "pricing-optimizer",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "pricing-optimizer-alert-1",
        "title": "Margin Compression",
        "condition": "margin_rate < 0.15",
        "severity": "critical",
        "message": "Margin rate below 15%",
        "for": "5m",
        "labels": {
          "project": "pricing-optimizer",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Margin rate below 15%"
        }
      },
      {
        "uid": "pricing-optimizer-alert-2",
        "title": "Low Conversion",
        "condition": "conversion_rate < 0.02",
        "severity": "warning",
        "message": "Conversion rate below 2%",
        "for": "5m",
        "labels": {
          "project": "pricing-optimizer",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Conversion rate below 2%"
        }
      },
      {
        "uid": "pricing-optimizer-alert-3",
        "title": "Competitive Disadvantage",
        "condition": "competitive_index < 0.8",
        "severity": "warning",
        "message": "Competitive index below 80%",
        "for": "5m",
        "labels": {
          "project": "pricing-optimizer",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Competitive index below 80%"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "pricing-optimizer-default-policy",
        "name": "Pricing Optimizer Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "pricing-optimizer-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "pricing-optimizer-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
