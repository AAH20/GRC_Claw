  "title": "Cross-Project Orchestrator - Grafana Dashboard",
  "uid": "cross-project-orchestrator",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "cross-project-orchestrator-alert-1",
        "title": "Low Project Health",
        "condition": "project_health_score < 0.7",
        "severity": "critical",
        "message": "Project health below 70%",
        "for": "5m",
        "labels": {
          "project": "cross-project-orchestrator",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Project health below 70%"
        }
      },
      {
        "uid": "cross-project-orchestrator-alert-2",
        "title": "Resource Overutilization",
        "condition": "resource_utilization > 0.9",
        "severity": "warning",
        "message": "Resource utilization above 90%",
        "for": "5m",
        "labels": {
          "project": "cross-project-orchestrator",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Resource utilization above 90%"
        }
      },
      {
        "uid": "cross-project-orchestrator-alert-3",
        "title": "Delivery Delay",
        "condition": "delivery_rate < 0.8",
        "severity": "critical",
        "message": "Delivery rate below 80%",
        "for": "5m",
        "labels": {
          "project": "cross-project-orchestrator",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Delivery rate below 80%"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "cross-project-orchestrator-default-policy",
        "name": "Cross-Project Orchestrator Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "cross-project-orchestrator-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "cross-project-orchestrator-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
