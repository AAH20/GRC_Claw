  "timepicker": {},
  "timezone": "",
  "title": "SEO Optimizer - Grafana Dashboard",
  "uid": "seo-optimizer",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "seo-optimizer-alert-1",
        "title": "Traffic Drop",
        "condition": "rate(organic_sessions_total[1h]) < -0.3",
        "severity": "critical",
        "message": "Organic traffic dropped 30%",
        "for": "5m",
        "labels": {
          "project": "seo-optimizer",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Organic traffic dropped 30%"
        }
      },
      {
        "uid": "seo-optimizer-alert-2",
        "title": "Ranking Decline",
        "condition": "keyword_position > 20",
        "severity": "warning",
        "message": "Keywords ranking below position 20",
        "for": "5m",
        "labels": {
          "project": "seo-optimizer",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Keywords ranking below position 20"
        }
      },
      {
        "uid": "seo-optimizer-alert-3",
        "title": "Slow Page Speed",
        "condition": "page_load_time_seconds > 3",
        "severity": "warning",
        "message": "Page load time above 3s",
        "for": "5m",
        "labels": {
          "project": "seo-optimizer",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Page load time above 3s"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "seo-optimizer-default-policy",
        "name": "SEO Optimizer Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "seo-optimizer-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "seo-optimizer-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
}