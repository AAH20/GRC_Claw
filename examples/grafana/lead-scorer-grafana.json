        "refresh": 1,
        "regex": "",
        "type": "datasource"
      },
      {
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(project)",
        "hide": 0,
        "includeAll": true,
        "label": "Project",
        "multi": true,
        "name": "project",
        "options": [],
        "query": {
          "query": "label_values(project)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Lead Scorer - Grafana Dashboard",
  "uid": "lead-scorer",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "lead-scorer-alert-1",
        "title": "Model Accuracy Drop",
        "condition": "score_accuracy < 0.75",
        "severity": "critical",
        "message": "Lead scoring model accuracy below 75%",
        "for": "5m",
        "labels": {
          "project": "lead-scorer",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Lead scoring model accuracy below 75%"
        }
      },
      {
        "uid": "lead-scorer-alert-2",
        "title": "Low Lead Volume",
        "condition": "rate(leads_created_total[1h]) < 10",
        "severity": "warning",
        "message": "Lead volume dropped significantly",
        "for": "5m",
        "labels": {
          "project": "lead-scorer",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Lead volume dropped significantly"
        }
      },
      {
        "uid": "lead-scorer-alert-3",
        "title": "High Model Uncertainty",
        "condition": "model_confidence < 0.6",
        "severity": "warning",
        "message": "Model confidence below 60%",
        "for": "5m",
        "labels": {
          "project": "lead-scorer",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Model confidence below 60%"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "lead-scorer-default-policy",
        "name": "Lead Scorer Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "lead-scorer-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "lead-scorer-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
}