  "timezone": "",
  "title": "Sales Forecaster - Grafana Dashboard",
  "uid": "sales-forecaster",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "sales-forecaster-alert-1",
        "title": "Low Forecast Accuracy",
        "condition": "forecast_accuracy < 0.7",
        "severity": "critical",
        "message": "Forecast accuracy below 70%",
        "for": "5m",
        "labels": {
          "project": "sales-forecaster",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Forecast accuracy below 70%"
        }
      },
      {
        "uid": "sales-forecaster-alert-2",
        "title": "Quota Shortfall",
        "condition": "quota_attainment < 0.8",
        "severity": "warning",
        "message": "Quota attainment below 80%",
        "for": "5m",
        "labels": {
          "project": "sales-forecaster",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Quota attainment below 80%"
        }
      },
      {
        "uid": "sales-forecaster-alert-3",
        "title": "High Prediction Error",
        "condition": "prediction_error > 0.3",
        "severity": "warning",
        "message": "Prediction error above 30%",
        "for": "5m",
        "labels": {
          "project": "sales-forecaster",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Prediction error above 30%"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "sales-forecaster-default-policy",
        "name": "Sales Forecaster Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "sales-forecaster-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "sales-forecaster-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
