  "title": "Affiliate Marketing - Grafana Dashboard",
  "uid": "affiliate-marketing",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "affiliate-marketing-alert-1",
        "title": "High Fraud Rate",
        "condition": "fraud_rate > 0.05",
        "severity": "critical",
        "message": "Fraud rate above 5%",
        "for": "5m",
        "labels": {
          "project": "affiliate-marketing",
          "severity": "critical"
        },
        "annotations": {
          "summary": "Fraud rate above 5%"
        }
      },
      {
        "uid": "affiliate-marketing-alert-2",
        "title": "Low Conversion",
        "condition": "conversion_rate < 0.01",
        "severity": "warning",
        "message": "Conversion rate below 1%",
        "for": "5m",
        "labels": {
          "project": "affiliate-marketing",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Conversion rate below 1%"
        }
      },
      {
        "uid": "affiliate-marketing-alert-3",
        "title": "Low Active Affiliates",
        "condition": "active_affiliates < 50",
        "severity": "warning",
        "message": "Active affiliates below 50",
        "for": "5m",
        "labels": {
          "project": "affiliate-marketing",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Active affiliates below 50"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "affiliate-marketing-default-policy",
        "name": "Affiliate Marketing Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "affiliate-marketing-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "affiliate-marketing-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
