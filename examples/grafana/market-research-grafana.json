  },
  "timepicker": {},
  "timezone": "",
  "title": "Market Research - Grafana Dashboard",
  "uid": "market-research",
  "version": 1,
  "weekStart": "",
  "alerting": {
    "rules": [
      {
        "uid": "market-research-alert-1",
        "title": "Low Response Rate",
        "condition": "response_rate < 5",
        "severity": "warning",
        "message": "Response rate below 5/min",
        "for": "5m",
        "labels": {
          "project": "market-research",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Response rate below 5/min"
        }
      },
      {
        "uid": "market-research-alert-2",
        "title": "Low Completion",
        "condition": "completion_rate < 0.6",
        "severity": "warning",
        "message": "Completion rate below 60%",
        "for": "5m",
        "labels": {
          "project": "market-research",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Completion rate below 60%"
        }
      },
      {
        "uid": "market-research-alert-3",
        "title": "High Cost",
        "condition": "cost_per_response > 50",
        "severity": "warning",
        "message": "Cost per response above $50",
        "for": "5m",
        "labels": {
          "project": "market-research",
          "severity": "warning"
        },
        "annotations": {
          "summary": "Cost per response above $50"
        }
      }
    ],
    "notification_policies": [
      {
        "uid": "market-research-default-policy",
        "name": "Market Research Default Notification Policy",
        "group_by": [
          "project",
          "severity"
        ],
        "group_wait": "30s",
        "group_interval": "5m",
        "repeat_interval": "4h",
        "routes": [
          {
            "uid": "market-research-critical-route",
            "name": "Critical Alerts",
            "matchers": [
              {
                "severity": "critical"
              }
            ],
            "receiver": "critical-alerts"
          },
          {
            "uid": "market-research-warning-route",
            "name": "Warning Alerts",
            "matchers": [
              {
                "severity": "warning"
              }
            ],
            "receiver": "warning-alerts"
          }
        ]
      }
    ]
  }
}