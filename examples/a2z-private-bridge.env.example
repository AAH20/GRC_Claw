# GRC_Claw Gateway
GRC_CLAW_HOST=127.0.0.1
GRC_CLAW_PORT=18791
GRC_CLAW_GATEWAY_TOKEN=replace-with-secret-manager-value

# Private A2Z SOC bridge (set mode=private in production)
A2Z_SOC_MODE=demo
A2Z_SOC_BASE_URL=https://your-private-a2z-soc.example
A2Z_SOC_API_KEY=
A2Z_SOC_TENANT_ID=1

# Agentic AI security (optional overrides)
# BYOC — LLM + MCP (see examples/connectors.config.example.json)
# GRC_CLAW_CONNECTORS_CONFIG=./connectors.config.json
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# GRC_CLAW_AGENT_MAX_CALLS=12
# GRC_CLAW_AGENT_SANDBOX=docker
