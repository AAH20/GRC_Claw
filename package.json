{
  "name": "grc-claw",
  "version": "1.0.0",
  "private": true,
  "description": "The OSS chassis for ISO 42001-compliant agentic AI — Swarm Harness, Anti-Swarm WAF, MAVLink & UAS compliance, a2zsoc.com bridge",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "console": "npm run dev -w @grc-claw/console",
    "build:console": "npm run build -w @grc-claw/console",
    "gateway": "npm run start -w @grc-claw/gateway",
    "doctor": "npm run doctor -w @grc-claw/gateway",
    "graph:coverage": "node scripts/graph-proof-coverage.mjs",
    "graph:coverage:history": "node scripts/graph-proof-coverage.mjs --write-history",
    "test": "npm run test -w @grc-claw/ingest",
    "test:iso42001": "bash scripts/test-iso-42001.sh",
    "test:byoc": "bash scripts/test-byoc-connectors.sh",
    "test:action-ledger": "npm run build && node scripts/test-action-ledger.mjs",
    "test:assurance": "npm run build && node scripts/test-assurance.mjs",
    "test:assurance-envelope": "npm run build && node scripts/test-assurance-envelope.mjs",
    "test:ai-ran-assurance": "npm run build -w @grc-claw/ai-ran-assurance && node scripts/test-ai-ran-assurance.mjs",
    "test:comprehensive": "bash scripts/test-comprehensive.sh",
    "test:skills": "npm run test -w @grc-claw/skill-executor",
    "test:orchestrator": "npm run test -w @grc-claw/compliance-orchestrator",
    "test:supply-chain": "npm run test -w @grc-claw/ai-supply-chain",
    "test:copilot": "npm run test -w @grc-claw/compliance-copilot",
    "test:continuous": "npm run test -w @grc-claw/continuous-compliance",
    "test:mesh": "npm run test -w @grc-claw/federated-compliance-mesh",
    "test:trust": "npm run test -w @grc-claw/agent-trust-score",
    "test:regulatory": "npm run test -w @grc-claw/regulatory-intelligence",
    "test:persistence": "npm run test -w @grc-claw/persistence",
    "test:cloud": "npm run test -w @grc-claw/cloud-connectors",
    "test:dev": "npm run test -w @grc-claw/dev-compliance",
    "test:business": "npm run test -w @grc-claw/business-impact",
    "test:threat": "npm run test -w @grc-claw/ai-threat-detection",
    "test:zk": "npm run test -w @grc-claw/zk-compliance",
    "test:marketplace": "npm run test -w @grc-claw/trust-marketplace",
    "test:mcp": "npm run test -w @grc-claw/mcp-server",
    "test:continuous-trust": "npm run test -w @grc-claw/continuous-trust-engine",
    "test:trust-transaction": "npm run test -w @grc-claw/trust-transaction",
    "test:agent-collab": "npm run test -w @grc-claw/agent-collaboration",
    "test:regulatory-mgmt": "npm run test -w @grc-claw/regulatory-change-management",
    "test:ai-governance": "npm run test -w @grc-claw/ai-governance",
    "test:knowledge-graph": "npm run test -w @grc-claw/compliance-knowledge-graph",
    "test:firewall": "npm run test -w @grc-claw/agent-policy-firewall",
    "test:procurement": "npm run test -w @grc-claw/defense-procurement",
    "test:verifier": "npm run test -w @grc-claw/verifier-network",
    "test:benchmark": "npm run test -w @grc-claw/benchmark-intelligence",
    "test:all": "npm run build && echo 'All 89 packages built successfully'"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "uuid": "^14.0.1"
  }
}
